# ─────────────────────────────────────────────────────────────────────────────
# Terminal Quest environment
# Everything here is OPTIONAL. With no variables at all the game runs fully:
# progress is stored in localStorage and the leaderboard falls back to local
# rival agents.
# ─────────────────────────────────────────────────────────────────────────────

# ── Leaderboard (Feature 1) ──────────────────────────────────────────────────
# With these two values set, /api/leaderboard stores the global top-25 board in
# Upstash Redis and `leaderboard submit` publishes your score for every player.
# Free tier is plenty: the board is only read/written on demand.
# Create a database at https://console.upstash.io
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Where the client posts scores. Defaults to the bundled /api/leaderboard.
# Set to "off" to stay local (useful for offline dev and E2E runs).
VITE_LEADERBOARD_API=

# ── Error tracking (optional) ────────────────────────────────────────────────
# Get a DSN from https://sentry.io/settings/projects/
VITE_SENTRY_DSN=

# ── Deployment ───────────────────────────────────────────────────────────────
# Set automatically by Vercel at build time.
VITE_APP_VERSION=
